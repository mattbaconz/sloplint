// Page fetcher for the docs site's "Score a page" box. Not deployed from CI: deploy by hand
// with `npx wrangler deploy` from this folder, then set FETCHER in site/score.js to its URL.
{
  "name": "sloplint-score",
  "main": "fetch-page.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    // Comma-separated origins that may call the fetcher.
    "ALLOWED_ORIGINS": "https://mattbaconz.github.io,https://sloplint.xyz"
  },
  // 10 pages a minute per visitor IP, one RateLimiter object per IP. SQLite-backed because the
  // Free plan requires it; the class keeps its state in memory and never writes to storage.
  "durable_objects": { "bindings": [{ "name": "LIMITER", "class_name": "RateLimiter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }],
  // Off: Workers Logs would store every request, scored URL included. PRIVACY.md says no
  // request logs are kept, so turn this on only with a matching change there.
  "observability": { "enabled": false }
}
